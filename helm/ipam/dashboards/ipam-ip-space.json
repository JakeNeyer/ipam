        {
          "id": "labelsToFields",
          "options": {
            "mode": "columns",
            "keepLabels": [
              "environment",
              "pool",
              "block",
              "cidr"
            ]
          }
        },
        {
          "id": "merge",
          "options": {}
        },
        {
          "id": "filterFieldsByName",
          "options": {
            "include": {
              "pattern": "^(environment|pool|block|cidr|ipam_block_utilization_ratio|ipam_block_used_ips|ipam_block_available_ips)$"
            }
          }
        },
        {
          "id": "organize",
          "options": {
            "indexByName": {
              "block": 0,
              "ipam_block_utilization_ratio": 1,
              "ipam_block_available_ips": 2,
              "cidr": 3,
              "environment": 4,
              "pool": 5,
              "ipam_block_used_ips": 6
            },
            "renameByName": {
              "environment": "Environment",
              "pool": "Pool",
              "block": "Block",
              "cidr": "CIDR",
              "ipam_block_utilization_ratio": "Fill",
              "ipam_block_used_ips": "Used",
              "ipam_block_available_ips": "Available"
            }
          }
        }
      ],
      "type": "table"
